              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "entrenamientos"
              ]
            },
            "description": "Es asíncrono: el progreso llega por el WebSocket /ws?token=... Espera unos segundos antes de consultar el detalle.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"objetivo\": \"riesgo\",\n  \"modo\": \"sharding\",\n  \"arboles\": 100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Aceptado (202) u ocupado (409)\", () => pm.expect(pm.response.code).to.be.oneOf([202, 409]));",
                  "if (pm.response.code === 202) pm.collectionVariables.set(\"entrenamientoId\", pm.response.json().id);",
                  "pm.test(\"Responde en menos de 100 ms\", () => pm.expect(pm.response.responseTime).to.be.below(100));"
                ]
              }
            }
          ]
        },
