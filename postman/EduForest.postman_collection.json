{
  "info": {
    "name": "EduForest API (PC4)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de la API coordinador de EduForest. Ejecuta primero Login: guarda el token en la variable {{token}}. Cada petición comprueba el status y que la respuesta llegue en menos de 100 ms (salvo el inicio del entrenamiento, que es asíncrono)."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "entrenamientoId",
      "value": ""
    },
    {
      "key": "codMod",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Salud",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "salud"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde en menos de 100 ms\", () => pm.expect(pm.response.responseTime).to.be.below(100));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"clave\": \"admin123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde en menos de 100 ms\", () => pm.expect(pm.response.responseTime).to.be.below(100));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", d.token);",
                  "pm.test(\"Devuelve un JWT\", () => pm.expect(d.token.split(\".\").length).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con clave incorrecta",
